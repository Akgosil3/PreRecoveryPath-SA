# =====================================================
# PreRecoveryPath SA - Environment Configuration
# =====================================================
# Copy this file to .env and configure for your environment
# NEVER commit .env file with actual values to git

# =====================================================
# Ethics Configuration (NON-NEGOTIABLE)
# =====================================================
MAX_DAILY_MINUTES=30
MAX_SESSION_MINUTES=10
MAX_DAILY_SESSIONS=5
CRISIS_THRESHOLD=0.95
AI_SESSIONS_BEFORE_HUMAN=3

# =====================================================
# Server Configuration
# =====================================================
NODE_ENV=development
PORT=3000
HOST=localhost

# =====================================================
# Database Configuration
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prerecoverypath_sa
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false

# =====================================================
# Security
# =====================================================
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Session secret
SESSION_SECRET=your_session_secret_here_change_in_production

# =====================================================
# POPIA Compliance (South African Data Protection)
# =====================================================
POPIA_MODE=strict
DATA_RETENTION_DAYS=90
AUTO_DELETE_ENABLED=true
GEOGRAPHIC_PRECISION=municipality
CONSENT_REQUIRED=true

# Information Officer Contact
POPIA_OFFICER_EMAIL=privacy@prerecoverypath.org.za
POPIA_OFFICER_PHONE=+27_XXX_XXX_XXXX

# =====================================================
# South African Integration
# =====================================================
SANCA_API_KEY=your_sanca_api_key_if_available
SANCA_INTEGRATION=true
SADAG_INTEGRATION=true
AA_NA_INTEGRATION=true

# =====================================================
# Crisis Resources
# =====================================================
SADAG_PHONE=0800567567
SANCA_PHONE=0861472622
LIFELINE_PHONE=0861322322
EMERGENCY_PHONE=10111

# =====================================================
# Cultural Configuration
# =====================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=zu,xh,af,en,nso,tn,st,ts,ss,ve,nr
SUPPORTED_PROVINCES=GP,WC,KZN,EC,LP,MP,NW,FS,NC

# =====================================================
# Notification Settings (Anti-Bombardment)
# =====================================================
MAX_DAILY_NOTIFICATIONS=2
MIN_HOURS_BETWEEN_NOTIFICATIONS=4
NOTIFICATION_TYPES_ALLOWED=crisis_support,meeting_reminder,check_in

# =====================================================
# Monitoring and Analytics (Privacy-Preserving)
# =====================================================
ENABLE_USAGE_MONITORING=true
ENABLE_ETHICS_LOGGING=true
ANONYMIZE_LOGS=true
LOG_RETENTION_DAYS=90

# =====================================================
# Email Configuration (for notifications, reports)
# =====================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@prerecoverypath.org.za

# =====================================================
# SMS Configuration (for crisis support, SMS fallback)
# =====================================================
SMS_PROVIDER=example_provider
SMS_API_KEY=your_sms_api_key
SMS_FROM_NUMBER=+27XXXXXXXXX

# =====================================================
# AI/ML Configuration
# =====================================================
AI_MODEL_PATH=./models/
EXPLAINABILITY_REQUIRED=true
CONFIDENCE_THRESHOLD=0.70
CULTURAL_ADAPTER_ENABLED=true

# =====================================================
# Rate Limiting (Anti-Addiction)
# =====================================================
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=30

# =====================================================
# Ethics Board Configuration
# =====================================================
ETHICS_BOARD_EMAIL=ethics@prerecoverypath.org.za
ETHICS_BOARD_NOTIFICATION_ENABLED=true
AUTO_REPORT_VIOLATIONS=true

# =====================================================
# Development & Testing
# =====================================================
DEBUG=false
ENABLE_TEST_USERS=false
MOCK_EXTERNAL_SERVICES=false

# =====================================================
# Feature Flags (All require Ethics Board approval)
# =====================================================
FEATURE_AI_COMPANION=true
FEATURE_PEER_MATCHING=false
FEATURE_TRADITIONAL_HEALER_NETWORK=true
FEATURE_SMS_FALLBACK=false

# =====================================================
# URLs
# =====================================================
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3000/api
DOCS_URL=http://localhost:3000/docs

# =====================================================
# Notes
# =====================================================
# 1. Change all secrets (JWT_SECRET, SESSION_SECRET, passwords) in production
# 2. NEVER commit .env file to version control
# 3. Ethics configuration values are non-negotiable per framework
# 4. POPIA_MODE=strict enforces all data protection requirements
# 5. All new features require Ethics Board approval
